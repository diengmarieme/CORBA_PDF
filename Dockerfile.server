FROM eclipse-temurin:8-jre-alpine
WORKDIR /app

RUN apk add --no-cache bash

COPY corba-server/target/corba-server.jar app.jar

ENV ORB_PORT=2809
ENV ORB_HOST=127.0.0.1
EXPOSE 8080

# On lance tnameserv discrètement en arrière-plan, puis l'application Java prend le contrôle complet immédiatement
RUN echo -e '#!/bin/bash\n\
tnameserv -ORBInitialPort 2809 &\n\
sleep 2\n\
java -Dorg.omg.CORBA.ORBInitialPort=2809 -Dorg.omg.CORBA.ORBInitialHost=127.0.0.1 -Dcom.sun.CORBA.ORBInitialPort=2809 -Dcom.sun.CORBA.ORBInitialHost=127.0.0.1 -jar app.jar' > start.sh && chmod +x start.sh

CMD ["./start.sh"]
