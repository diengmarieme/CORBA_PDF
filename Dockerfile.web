# Étape 1 : Compilation du projet avec Maven et Java 11
FROM maven:3.8.5-openjdk-11 AS build
WORKDIR /app

# Copier l'ensemble du projet
COPY . .

# ASTUCE : Nettoyer chirurgicalement les doublons de IPDFServicePOA.java avant compilation
RUN if [ -f web-middleware/src/main/java/pdfservice/IPDFServicePOA.java ]; then \
    sed -i '/public.*imagesToPdf/,/}/d' web-middleware/src/main/java/pdfservice/IPDFServicePOA.java && \
    sed -i '/case.*imagesToPdf/,/break;/d' web-middleware/src/main/java/pdfservice/IPDFServicePOA.java; \
    fi

RUN if [ -f web-middleware/src/main/java/PDFService/IPDFServicePOA.java ]; then \
    sed -i '/public.*imagesToPdf/,/}/d' web-middleware/src/main/java/PDFService/IPDFServicePOA.java && \
    sed -i '/case.*imagesToPdf/,/break;/d' web-middleware/src/main/java/PDFService/IPDFServicePOA.java; \
    fi

# Compiler uniquement le module web-middleware en sautant les tests
RUN mvn clean package -pl web-middleware -DskipTests

# Étape 2 : Création de l'image d'exécution finale légère
FROM eclipse-temurin:11-jre-alpine
WORKDIR /app

# Récupérer le JAR généré à l'étape précédente
COPY --from=build /app/web-middleware/target/web-middleware-*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
