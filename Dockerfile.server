FROM eclipse-temurin:8-jre-alpine
WORKDIR /app

RUN apk add --no-cache bash

COPY corba-server/target/corba-server.jar app.jar

# On injecte le port directement via les propriétés système Java (-Dcom.sun.CORBA...)
RUN echo -e '#!/bin/bash\n\
tnameserv -ORBInitialPort 2809 &\n\
sleep 5\n\
java -Dcom.sun.CORBA.ORBInitialPort=2809 -Dcom.sun.CORBA.ORBInitialHost=localhost -jar app.jar' > start.sh && chmod +x start.sh

CMD ["./start.sh"]
