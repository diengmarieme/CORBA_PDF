FROM maven:3.9-eclipse-temurin-11-alpine AS builder
WORKDIR /build
COPY corba-server/pom.xml .
COPY corba-server/libs ./libs
RUN mvn dependency:go-offline -q 2>/dev/null || true
COPY corba-server/src ./src
RUN mvn package -DskipTests -q

FROM eclipse-temurin:11-jre-alpine
LABEL description="PDF CORBA Server"
WORKDIR /app
COPY --from=builder /build/target/corba-server.jar /app/corba-server.jar
COPY corba-server/jacorb.properties /app/jacorb.properties
RUN printf '#!/bin/sh\nset -e\necho "[start] Lancement Serveur CORBA avec InitRef..."\nsleep 15\nexec java -Djacorb.config.dir=/app -Djava.awt.headless=true -Xmx512m -Xms128m -jar /app/corba-server.jar -ORBInitRef NameService=corbaloc:iiop:naming:2809/NameService\n' > /app/start.sh && chmod +x /app/start.sh
EXPOSE 2810
ENTRYPOINT ["/app/start.sh"]
